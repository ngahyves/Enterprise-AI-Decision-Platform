# ===============================================================
# GLOBAL APP SETTINGS
# ===============================================================
APP_ENV=development
PROJECT_NAME="Enterprise-AI-Assistant"
LOG_LEVEL=DEBUG
LOG_TO_FILE=true

# ===============================================================
# LLM & RERANKING PROVIDERS (FREE/LOW-COST TIER)
# ===============================================================
# GROQ: Ultra-fast inference for agent logic (Phase 14)
GROQ_API_KEY=Your_grok_api_key

# GOOGLE GEMINI: Long-document analysis and extraction (Phases 3 & 10)
GOOGLE_API_KEY=Your_gemini_api_key

#API KEY
API_KEY=my_secret_api_key

# ===============================================================
# DATA INGESTION
# ===============================================================
# LLAMAPARSE: Structural extraction of financial tables (Phase 2)
LLAMA_CLOUD_API_KEY=your_llama_key

# ===============================================================
# VECTOR DATABASE & STORAGE (DOCKER / LOCAL)
# ===============================================================
# QDRANT: Vector Storage (Phase 6) and cache
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME="bank_reports_2025"
REDIS_HOST=localhost
REDIS_PORT=6379

# POSTGRES: Storage of Feedback and History (Phases 16 & 19)
POSTGRES_DB=ai_assistant_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===============================================================
# OBSERVABILITY & TRACING
# ===============================================================
# LANGSMITH: Mandatory debugging of LangGraph workflows (Phase 18)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_key
LANGCHAIN_PROJECT="enterprise-ai-assistant"
